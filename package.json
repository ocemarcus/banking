{
	"name": "banking",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node --inspect dist/src/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "vitest",
		"test:cov": "vitest --coverage",
		"drizzle:g": "npx drizzle-kit generate",
		"drizzle:m": "npx drizzle-kit migrate"
	},
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/core": "^11.0.1",
		"@nestjs/cqrs": "^11.0.3",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/swagger": "^11.2.6",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"cpf-cnpj-validator": "^1.0.3",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"moment": "^2.30.1",
		"pg": "^8.18.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"simpleflakes": "^4.0.0",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.10.7",
		"@types/pg": "^8.16.0",
		"@types/supertest": "^6.0.2",
		"@types/uuid": "^10.0.0",
		"@vitest/coverage-v8": "^4.0.18",
		"drizzle-kit": "^0.31.9",
		"globals": "^16.0.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0",
		"unplugin-swc": "^1.5.9",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.0.18"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
